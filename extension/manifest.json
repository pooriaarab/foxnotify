{
  "manifest_version": 3,
  "name": "foxnotify demo",
  "version": "0.1.0",
  "description": "Tell the user when a Firefox agent task needs them, on desktop and phone, with quiet hours.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxnotify@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxnotify demo",
    "default_popup": "popup.html"
  }
}
