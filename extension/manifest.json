{
  "manifest_version": 3,
  "name": "foxnotify — notices for browser agents",
  "version": "0.1.0",
  "description": "Tell the user when a browser agent task needs them, with quiet hours, a digest and an optional phone webhook.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxnotify@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxnotify",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
