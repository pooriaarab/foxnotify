{
  "name": "foxnotify",
  "version": "0.1.2",
  "description": "Firefox AI agent notifications with quiet hours, digests, approval click routing, ntfy webhooks and an optional foxsync phone bridge.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxnotify.git"
  },
  "homepage": "https://github.com/pooriaarab/foxnotify#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "web-ext lint -s dist-ext --warnings-as-errors",
    "e2e": "node scripts/build-ext.mjs --e2e && node e2e/run.mjs",
    "check:amo": "node scripts/amo-listing.mjs check"
  },
  "peerDependencies": {
    "foxsync": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "foxsync": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "create-foxkit": "^0.1.0",
    "esbuild": "^0.28.2",
    "web-ext": "^10.7.0"
  },
  "keywords": [
    "firefox",
    "webextension",
    "ai-agent",
    "notifications",
    "quiet-hours",
    "notification-digest",
    "approval-alerts",
    "ntfy",
    "webhooks",
    "foxsync",
    "desktop-notifications",
    "typescript",
    "rate-limiting",
    "deduplication"
  ]
}
